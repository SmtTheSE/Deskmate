# Everything here is optional. Deskmate works without a .env file.

# The address people use to reach Deskmate. Used in links in emails and for Twilio.
PUBLIC_URL=http://localhost:3000

# Port on this computer.
PORT=3000

# Encrypts saved keys and passwords. If empty, a key is generated and stored in the data folder.
APP_SECRET=

# Set to true when running behind a reverse proxy (Caddy, nginx, Traefik).
TRUST_PROXY=false
